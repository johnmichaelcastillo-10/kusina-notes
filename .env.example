# Copy to .env and set real passwords.
WP_PORT=8092
WP_URL=http://localhost:8092
WP_TITLE=Kusina Notes
WP_DEBUG=1

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Public URL of the static site (e.g. https://kusina-notes.vercel.app). Used for canonical,
# og:url and sitemap links.
STATIC_URL=

# Admin login for the local site (wp core install).
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=johnmichaelcastillo.it@gmail.com
