{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kusina/recipe-card",
	"version": "0.4.0",
	"title": "Recipe card",
	"category": "text",
	"icon": "carrot",
	"description": "Ingredients, method and tips for one recipe. Times and servings come from the Recipe details panel.",
	"textdomain": "kusina-core",
	"attributes": {
		"groups": {
			"type": "array",
			"default": [ { "title": "", "items": [] } ]
		},
		"steps": {
			"type": "array",
			"default": []
		},
		"tips": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"align": [ "wide" ]
	},
	"usesContext": [ "postId", "postType" ],
	"editorScript": "file:./editor.js",
	"editorStyle": [ "dashicons", "file:./editor.css" ],
	"style": "file:./style.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
