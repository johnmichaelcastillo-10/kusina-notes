{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#F7F2E8" },
				{ "slug": "paper-2", "name": "Paper 2", "color": "#EFE7D7" },
				{ "slug": "ink", "name": "Ink", "color": "#221C15" },
				{ "slug": "ink-2", "name": "Ink 2", "color": "#5A5046" },
				{ "slug": "annatto", "name": "Annatto", "color": "#B4441C" },
				{ "slug": "calamansi", "name": "Calamansi", "color": "#5E7A2C" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "Newsreader, Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.5rem, 1.2rem + 1.2vw, 2rem)" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)" }
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "72rem"
		},
		"spacing": {
			"padding": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": { "left": "1rem", "right": "1rem" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--annatto)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
