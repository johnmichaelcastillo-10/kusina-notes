{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "enamel", "name": "Enamel", "color": "#FBFAF6" },
				{ "slug": "enamel-2", "name": "Enamel 2", "color": "#F0EEE6" },
				{ "slug": "ink", "name": "Ink", "color": "#16213E" },
				{ "slug": "ink-2", "name": "Ink 2", "color": "#4A5372" },
				{ "slug": "cobalt", "name": "Cobalt", "color": "#1F3FA8" },
				{ "slug": "on-cobalt", "name": "On cobalt", "color": "#FFFFFF" },
				{ "slug": "cardboard", "name": "Cardboard", "color": "#E2C48F" },
				{ "slug": "ulam", "name": "Ulam (tomato)", "color": "#C93A26" },
				{ "slug": "sabaw", "name": "Sabaw (kangkong)", "color": "#2B7A4B" },
				{ "slug": "merienda", "name": "Merienda (mango)", "color": "#F4B62C" },
				{ "slug": "panghimagas", "name": "Panghimagas (ube)", "color": "#6B48B3" },
				{ "slug": "almusal", "name": "Almusal (egg yolk)", "color": "#EE8A27" },
				{ "slug": "inumin", "name": "Inumin (calamansi)", "color": "#9CC43E" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque",
					"fontFamily": "'Bricolage Grotesque', 'Arial Black', 'Helvetica Neue', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStretch": "75% 100%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/bricolage-grotesque.woff2" ]
						},
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStretch": "75% 100%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+2150-215E",
							"src": [ "file:./assets/fonts/bricolage-grotesque-fractions.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Atkinson Hyperlegible Next",
					"fontFamily": "'Atkinson Hyperlegible Next', 'Segoe UI', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/atkinson-hyperlegible-next.woff2" ]
						},
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontWeight": "200 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/atkinson-hyperlegible-next-italic.woff2" ]
						}
					]
				},
				{
					"slug": "hand",
					"name": "Caveat",
					"fontFamily": "Caveat, 'Segoe Print', 'Bradley Hand', cursive",
					"fontFace": [
						{
							"fontFamily": "Caveat",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/caveat.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2.125rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "5rem", "fluid": { "min": "3rem", "max": "6.25rem" } }
			]
		},
		"layout": {
			"contentSize": "44rem",
			"wideSize": "74rem"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--enamel)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": { "left": "1.25rem", "right": "1.25rem" },
			"blockGap": "1.25rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "1.25rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--cobalt)" },
				"typography": { "textDecoration": "underline" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
