    "steps": [
      {
        "text": "Heat the oven to 375°F (190°C). Line three 6-inch round pans or one 9-inch pan with banana leaves and brush with butter.",
        "minutes": null
      },
      {
        "text": "Whisk the rice flour, baking powder and salt. In another bowl beat the eggs with the sugar until pale, then add the coconut milk and melted butter. Whisk in the flour mixture until smooth.",
        "minutes": null
      },
      {
        "text": "Pour into the pans and bake until the top is just set.",
        "minutes": 15
      },
      {
        "text": "Arrange the salted egg slices and cheese on top and bake until risen, golden at the edges and a toothpick comes out clean.",
        "minutes": 10
      },
      {
        "text": "Broil until the top is spotted brown, watching closely.",
        "minutes": 2
      },
      {
        "text": "Brush with softened butter, sprinkle with sugar and serve warm with grated coconut.",
        "minutes": null
      }
