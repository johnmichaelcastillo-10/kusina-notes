    "steps": [
      {
        "text": "Season the beef with salt and pepper. Heat the oil in a heavy pot over medium-high heat and brown the beef on all sides in batches. Set aside.",
        "minutes": null
      },
      {
        "text": "Lower the heat to medium. Sauté the onion in the same pot until soft, then add the garlic and cook until fragrant.",
        "minutes": null
      },
      {
        "text": "Stir in the tomato paste and cook for a minute. Return the beef and its juices, then add the tomato sauce, water and bay leaves. Bring to a boil.",
        "minutes": null
      },
      {
        "text": "Cover, lower the heat and simmer until the beef is fork-tender, stirring now and then and adding a splash of water if the sauce gets too thick.",
        "minutes": 90
      },
      {
        "text": "Add the potatoes and carrots and simmer, uncovered, until just tender.",
        "minutes": 15
      },
      {
        "text": "Stir in the liver spread and chilies and simmer until the sauce turns thick and glossy.",
        "minutes": 5
      },
      {
        "text": "Add the bell peppers, olives and cheese. Cook until the cheese melts and the peppers are bright but still a little crisp.",
        "minutes": 3
      },
      {
        "text": "Season with fish sauce, salt and pepper. Remove the bay leaves and serve hot with rice.",
        "minutes": null
      }
    ],
    "tips": "For potatoes and carrots that hold their shape, fry them in the oil until lightly browned before the beef goes in, set them aside, and add them back for the last 10 minutes."
