    "steps": [
      {
        "text": "Bring the water, onion and tomatoes to a boil, then simmer until the tomatoes soften.",
        "minutes": 5
      },
      {
        "text": "Meanwhile, boil the tamarind in the 2 cups of water until the skins split and the flesh turns soft.",
        "minutes": 15
      },
      {
        "text": "Mash the tamarind in its water with a fork, then press it through a strainer into a bowl. Discard the seeds and skins and keep the thick sour juice.",
        "minutes": null
      },
      {
        "text": "Add the radish and simmer until it starts to turn translucent.",
        "minutes": 5
      },
      {
        "text": "Add the fish, lower the heat and simmer gently without stirring until the fish is just cooked.",
        "minutes": 8
      },
      {
        "text": "Add the eggplant and okra and simmer until tender.",
        "minutes": 4
      },
      {
        "text": "Stir in the tamarind juice to taste, add the chilies and season with fish sauce.",
        "minutes": null
      },
      {
        "text": "Turn off the heat, add the water spinach and cover until wilted. Serve hot.",
        "minutes": 2
      }
    ],
    "tips": "Shake the pot instead of stirring once the fish is in, so the pieces stay whole."
